; Engine configuration file.
; Prefer editing through the Godot editor unless a textual change is intentional.

config_version=5

[application]

config/name="Mage Prototype"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[debug]

file_logging/enable_file_logging=false

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"unicode":119)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"unicode":115)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"unicode":97)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100)]
}
primary_spell={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
dash={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Hitbox"
3d_physics/layer_5="Hurtbox"
3d_physics/layer_6="Projectile"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=18.0

[rendering]

textures/default_filters/use_nearest_mipmap_filter=false
